# =============================================================
# GeoNexus Execution Plane 环境变量模板
# =============================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#   vi .env
# =============================================================

# ── 节点认证 ──
# Java 后台访问 GeoMCP 时使用的 API Key
GEONEXUS_NODE_API_KEY=change-this-key-in-production

# ── OGE 计算中心 ──
# 如果不使用 OGE 能力，留空即可
GEONEXUS_OGE_ENDPOINT=
GEONEXUS_OGE_USERNAME=
GEONEXUS_OGE_PASSWORD=
GEONEXUS_OGE_CLIENT_ID=
GEONEXUS_OGE_CLIENT_SECRET=

# ── LLM（GeoAgent 自然语言目标翻译） ──
# 如果不使用自然语言功能，留空即可
GEONEXUS_LLM_API_KEY=
GEONEXUS_LLM_BASE_URL=https://api.openai.com/v1
GEONEXUS_LLM_MODEL=gpt-4o-mini

# ── 日志级别 ──
GEONEXUS_LOG_LEVEL=INFO